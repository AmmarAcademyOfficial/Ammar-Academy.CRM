# Ammar Academy CRM — environment variables
# Copy to .env.local. Placeholders only. Never commit real values.
# Step-by-step instructions: docs/SETUP.md

# ── Database (Phase 2) ────────────────────────────────
# Local review: postgres://postgres:postgres@localhost:54329/crm  (npm run db:local)
# Supabase: Project Settings → Database → Connection string → "Transaction" pooler
DATABASE_URL=postgres://postgres:postgres@localhost:54329/crm

# ── Sign-in (Phase 2) ─────────────────────────────────
# "supabase" for real email/password logins. "local" = pick a staff member, no password;
# refused unless DATABASE_URL points at this computer.
AUTH_MODE=local
LOCAL_AUTH_SECRET=replace-with-any-long-random-text

# Supabase (needed when AUTH_MODE=supabase). Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only: invitations and disabling logins. Never sent to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public address of the CRM, used in invitation and password-reset links.
APP_URL=http://localhost:3000

# ── Google Sheets one-click connection (Phase 3) ──────
# "fake" = simulated Google with fictional sheets (local database only); "real" needs
# the one-time Google setup in docs/GOOGLE_SHEETS_CONNECTION.md; "off" hides the feature.
GOOGLE_MODE=fake
# GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# GOOGLE_PICKER_API_KEY=replace-me
# GOOGLE_PROJECT_NUMBER=123456789012
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Google sign-ins.
# TOKEN_ENCRYPTION_KEY=replace-me

# ── Scheduler (Phase 3) ───────────────────────────────
# Shared secret the scheduler sends to /api/cron/tick (docs/SCHEDULER.md). At least 24 characters.
CRON_SECRET=replace-with-a-long-random-string-0000

# ── Payment receipts (Phase 4) ────────────────────────
# "local" keeps receipts in a private folder on this computer (review only).
# "supabase" uses the private Supabase Storage bucket "receipts" (created by the migrations)
# and needs SUPABASE_SECRET_KEY. Receipts are never public; the CRM checks permission on every download.
STORAGE_MODE=local
RECEIPTS_DIR=.local/receipts
